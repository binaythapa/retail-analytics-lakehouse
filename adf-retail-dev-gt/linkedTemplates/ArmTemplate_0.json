{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-retail-dev-gt"
		},
		"snconnection_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'snconnection'"
		},
		"snconnection_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "mystyle"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/snconnection')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "SnowflakeV2",
				"typeProperties": {
					"authenticationType": "Basic",
					"accountIdentifier": "pbxpsjy-uc38847",
					"user": "tbinay",
					"database": "[parameters('snconnection_properties_typeProperties_database')]",
					"warehouse": "compute_wh",
					"password": {
						"type": "SecureString",
						"value": "[parameters('snconnection_password')]"
					},
					"useUtcTimestamps": false
				},
				"version": "1.1"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/stagetotable')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "stagetotable",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "snconnection",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": "USE DATABASE MYSTYLE;\nUSE SCHEMA PUBLIC;\n\nCOPY INTO CUSTOMERS\nFROM @RETAIL_STAGE/customers.csv.gz\nFILE_FORMAT = (FORMAT_NAME = 'CSV_FORMAT')\nON_ERROR = 'CONTINUE'"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00",
							"treatDecimalAsString": false
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-07-05T10:59:57Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/snconnection')]"
			]
		}
	]
}